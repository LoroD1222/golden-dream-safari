# Public site origin used for canonicals, sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Resend configuration. Never prefix the API key with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Golden Dream Safaris <quotes@example.com>
RESEND_TO_EMAIL=goldendreamsafaris@gmail.com

# Server-only HMAC secret for per-trip PDF access cookies. Use a long random value.
# When omitted, RESEND_API_KEY is used so successful enquiries can still unlock PDFs.
ITINERARY_ACCESS_SECRET=

# Optional HTTP Basic Auth for /admin and itinerary APIs.
# Hosted environments hide the editor unless both values are configured.
ITINERARY_ADMIN_USER=
ITINERARY_ADMIN_PASSWORD=
